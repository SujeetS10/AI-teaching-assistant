GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
SUBJECT_NAME=Multivariable Control Systems

# Protects the /admin dashboard (view + resolve student questions).
# Pick your own username/password - don't leave these as the defaults.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Optional: signs the admin login session cookie. If left unset, a random
# one is generated each time the server starts, which just means you'll
# need to log back in to /admin after every restart. Set your own random
# string here (any long random text) to keep sessions across restarts.
ADMIN_SESSION_SECRET=
